#!/usr/bin/env bash
# spec-kit OKF post-commit v1
set -euo pipefail
[[ "${OKF_AUTO_SYNC:-0}" == 1 ]] && exit 0
root="$(git rev-parse --show-toplevel)"
cd -- "$root"
sha="$(git rev-parse HEAD)"
message="$(git log -1 --format=%B "$sha")"
[[ "$message" == *'docs(wiki):'* ]] && exit 0
has_source_change=false
while IFS= read -r -d '' file; do
  [[ "$file" == 'src/.gitkeep' ]] || { has_source_change=true; break; }
done < <(git diff-tree --root -m --first-parent --no-commit-id --name-only -z -r "$sha" -- src/)
$has_source_change || exit 0
log="$(git rev-parse --git-path okf-auto-sync.log)"
nohup node "$root/.spec-kit/bin/auto-sync-wiki.js" --commit "$sha" >> "$log" 2>&1 < /dev/null &
